# DVP 摄像头 + 16MB PSRAM（官方 esp_video 例程同款配置）
CONFIG_SPIRAM=y

# 摄像头传感器：官方模块丝印是 OV5640（自带 24MHz 晶振），
# 同时保留 OV2640 自动探测，两个驱动谁先认出来用谁。
CONFIG_CAMERA_OV2640=y
CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV2640_DVP_RGB565_240X240_25FPS=y

# OV5640 只支持 DVP 800x600；选 RGB565，代码里会缩到 240x240 上屏
CONFIG_CAMERA_OV5640=y
CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5640_DVP_RGB565_800X600_10FPS=y
CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_RGB565_800X600_10FPS=y

# 只用 DVP 采集，不开 ISP / JPEG 编解码，省内存和编译时间
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
